# ===================== CẤU HÌNH KẾT NỐI SQL SERVER =====================
# Tên server: xem trong SSMS ô "Server name" (VD: localhost, .\SQLEXPRESS, LAPTOP-XXXX\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=NPK

# Cách đăng nhập SQL Server:
#   windows -> Windows Authentication (giống khi mở SSMS chọn "Windows Authentication")
#   sql     -> SQL Server Authentication (tài khoản sa / user + mật khẩu)
DB_AUTH=windows

# Chỉ dùng khi DB_AUTH=sql
DB_USER=sa
DB_PASSWORD=123456
# DB_PORT=1433

# Driver ODBC (chỉ dùng khi DB_AUTH=windows). Có thể đổi thành "ODBC Driver 18 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ===================== WEB SERVER =====================
PORT=3000
TOKEN_SECRET=npk-shop-doi-chuoi-bi-mat-nay
